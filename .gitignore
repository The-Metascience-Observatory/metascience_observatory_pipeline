# Large pipeline data & checkpoints (source of truth lives on disk, not in git)
data/*
!data/dictionaries/
!data/dictionaries/**
progress/

# Secrets
.env.local*

# Benchmarking ground-truth corpora (PDFs, large)
benchmarking/ground_truth_data_filtered_PDFs/
# LLM-matcher decision cache (re-derivable; keyed by prompt+model+content hash)
benchmarking/cache/

# Extraction test fixture outputs
mo_pipeline/extract/test_pdf/*/

# Runtime state for api/dashboard services
.run/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
server/.venv/

# Node / Next.js (anywhere — a stray HOME under dashboard/ once put 216MB of
# webpack cache into git history; keep these path-agnostic)
node_modules/
.next/
dashboard/home/
**/.cache/
*.tsbuildinfo

# Test caches
.pytest_cache/

# Editor/OS noise
.DS_Store
dashboard/next-env.d.ts
# extraction/download run logs under benchmarking/results (large, regenerable)
benchmarking/results/*.log

# Workbench source evidence (paper PDFs and page images): kept on disk, hashed in packets
benchmarking/gold/workbench_v2/sources/**/*.pdf
benchmarking/gold/workbench_v2/sources/**/*.png
